 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# SpaceX Falcon 9 Interactive Dashboard\n",
    "\n",
    "This notebook prepares an interactive Plotly Dash dashboard for analyzing SpaceX Falcon 9 launch outcomes and payload relationships.\n",
    "\n",
    "The dashboard contains launch-site selection, success/failure analysis, and payload-versus-outcome visualization."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Import Libraries"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import requests\n",
    "import pandas as pd\n",
    "import plotly.express as px\n",
    "from dash import Dash, dcc, html, Input, Output"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Load SpaceX Launch Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "response = requests.get(\"https://api.spacexdata.com/v4/launches/past\")\n",
    "response.raise_for_status()\n",
    "\n",
    "launches = response.json()\n",
    "df = pd.json_normalize(launches)\n",
    "\n",
    "rocket_response = requests.get(\"https://api.spacexdata.com/v4/rockets\")\n",
    "rocket_response.raise_for_status()\n",
    "\n",
    "rockets = rocket_response.json()\n",
    "rocket_lookup = {rocket[\"id\"]: rocket[\"name\"] for rocket in rockets}\n",
    "\n",
    "df[\"rocket_name\"] = df[\"rocket\"].map(rocket_lookup)\n",
    "df = df[df[\"rocket_name\"].str.contains(\"Falcon 9\", na=False)].copy()\n",
    "\n",
    "df[\"date_utc\"] = pd.to_datetime(df[\"date_utc\"], errors=\"coerce\")\n",
    "df[\"year\"] = df[\"date_utc\"].dt.year\n",
    "df[\"Outcome\"] = df[\"success\"].map({True: \"Success\", False: \"Failure\"})\n",
    "\n",
    "print(\"Falcon 9 launches:\", len(df))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Prepare Dashboard Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "dashboard_df = df[[\n",
    "    \"name\",\n",
    "    \"date_utc\",\n",
    "    \"year\",\n",
    "    \"launchpad\",\n",
    "    \"Outcome\",\n",
    "    \"rocket_name\"\n",
    "]].copy()\n",
    "\n",
    "dashboard_df.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Create Success/Failure Pie Chart"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "outcome_counts = dashboard_df[\"Outcome\"].value_counts().reset_index()\n",
    "outcome_counts.columns = [\"Outcome\", \"Count\"]\n",
    "\n",
    "fig_pie = px.pie(\n",
    "    outcome_counts,\n",
    "    names=\"Outcome\",\n",
    "    values=\"Count\",\n",
    "    title=\"Falcon 9 Launch Outcomes\"\n",
    ")\n",
    "\n",
    "fig_pie.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Launches by Launch Site"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "site_counts = dashboard_df[\"launchpad\"].value_counts().reset_index()\n",
    "site_counts.columns = [\"Launch Site\", \"Launches\"]\n",
    "\n",
    "fig_site = px.bar(\n",
    "    site_counts,\n",
    "    x=\"Launch Site\",\n",
    "    y=\"Launches\",\n",
    "    title=\"Falcon 9 Launches by Launch Site\"\n",
    ")\n",
    "\n",
    "fig_site.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Launch Trend by Year"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "year_counts = dashboard_df.groupby(\"year\").size().reset_index(name=\"Launches\")\n",
    "\n",
    "fig_year = px.line(\n",
    "    year_counts,\n",
    "    x=\"year\",\n",
    "    y=\"Launches\",\n",
    "    markers=True,\n",
    "    title=\"Falcon 9 Launches by Year\"\n",
    ")\n",
    "\n",
    "fig_year.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Build Plotly Dash Application"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "app = Dash(__name__)\n",
    "\n",
    "launch_sites = sorted(dashboard_df[\"launchpad\"].dropna().unique())\n",
    "\n",
    "app.layout = html.Div([\n",
    "    html.H1(\"SpaceX Falcon 9 Launch Dashboard\"),\n    "\n",
    "    html.Label(\"Select Launch Site:\"),\n    "    dcc.Dropdown(\n    "        id=\"launch-site-dropdown\",\n    "        options=[{\"label\": site, \"value\": site} for site in launch_sites],\n    "        value=launch_sites[0] if launch_sites else None,\n    "        clearable=False\n",
    "    ),\n    "\n    "    dcc.Graph(id=\"success-pie-chart\"),\n    "    dcc.Graph(id=\"launch-trend-chart\")\n",
    "])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Dashboard Callback"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "@app.callback(\n",
    "    Output(\"success-pie-chart\", \"figure\"),\n",
    "    Output(\"launch-trend-chart\", \"figure\"),\n",
    "    Input(\"launch-site-dropdown\", \"value\")\n",
    ")\n",
    "def update_dashboard(selected_site):\n",
    "    filtered = dashboard_df[dashboard_df[\"launchpad\"] == selected_site]\n",
    "\n",
    "    outcome = filtered[\"Outcome\"].value_counts().reset_index()\n",
    "    outcome.columns = [\"Outcome\", \"Count\"]\n",
    "\n",
    "    pie_fig = px.pie(\n",
    "        outcome,\n",
    "        names=\"Outcome\",\n",
    "        values=\"Count\",\n",
    "        title=f\"Launch Outcomes: {selected_site}\"\n",
    "    )\n",
    "\n",
    "    yearly = filtered.groupby(\"year\").size().reset_index(name=\"Launches\")\n",
    "\n",
    "    trend_fig = px.line(\n",
    "        yearly,\n",
    "        x=\"year\",\n",
    "        y=\"Launches\",\n",
    "        markers=True,\n",
    "        title=f\"Launch Trend: {selected_site}\"\n",
    "    )\n",
    "\n",
    "    return pie_fig, trend_fig"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Run the Dashboard\n",
    "\n",
    "The following command can be used when running the notebook locally."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# app.run(debug=True)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Conclusion\n",
    "\n",
    "The notebook prepares an interactive Plotly Dash dashboard for exploring Falcon 9 launch outcomes and launch trends by site."
   ]
  }
